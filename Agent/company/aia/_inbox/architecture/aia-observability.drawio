        <mxCell id="ne1" value="Structured Streaming (dp-rlt/fw · mdle_monitor/offset) + Batch (dp-bt/fw)  →  ADLS medallion (RAW→Persist→Staging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#E0632F;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="540" height="58" as="geometry"/></mxCell>
        <mxCell id="ne2" value="COST: Azure Cost Mgmt Export → ADLS → 5-layer ETL (keep custom_tags MAP) → cost_wide GOLD (tag_team top-level col).  Export=actual-$(+VM) · system.billing=DBU-list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#E0632F;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="590" y="430" width="555" height="58" as="geometry"/></mxCell>
