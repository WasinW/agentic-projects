        <mxCell id="nf" value="system.lakeflow.job_run_timeline/task (run/fail/SLA + MISSING-run) · system.compute · system.query.history · system.access.audit (RLS proof)   +   DQ: Anomaly detection (freshness/completeness) · Data profiling (drift) · tag-coverage%≥95   →  gold_ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#2E7D32;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="540" width="1110" height="42" as="geometry"/></mxCell>
        <mxCell id="G" value="LANE G — SERVING &amp; ACCESS (per-team RLS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3D74C9;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="604" width="1140" height="80" as="geometry"/></mxCell>
        <mxCell id="ng" value="v_billing_priced_rls / v_genie_priced_rls  (is_account_group_member() + team_access_map · embed_credentials:false · 4 grants incl EXECUTE)  →  Dashboard A · B · C(deferred).   ⚠ GATE C: GRANT ≠ network path (403 if firewall/PE closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#3D74C9;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="634" width="1110" height="42" as="geometry"/></mxCell>
