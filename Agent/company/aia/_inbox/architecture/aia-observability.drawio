        <mxCell id="nc" value="Prometheus (self-managed · PROD-only · NO kube-state-metrics)  →  Grafana (strimzi-operators.json)  →  Grafana-managed alert (no Alertmanager)  ⇒ Mail + Teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#0D9488;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="258" width="1110" height="30" as="geometry"/></mxCell>
