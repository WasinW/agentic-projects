        <mxCell id="ni" value="Departmental teams (own workspace+warehouse · RLS-scoped) · FinOps (base views) · on-call (Teams / PagerDuty via Azure Monitor)  ⇐ both panes escalate here, dashboards stay separate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#607D8B;fontSize=9;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="726" width="1110" height="28" as="geometry"/></mxCell>
